GOGYMGO_API_URL=

# Canonical member-app origin. Landing conversion actions enter the live /join
# flow, while the product showcase opens the isolated /demo flow.
NEXT_PUBLIC_MEMBER_APP_ORIGIN=https://app.gogymgo.com

# Dedicated administrator sign-in. Keep this configurable so the footer can
# move to admin.gogymgo.com without another application release.
NEXT_PUBLIC_ADMIN_DASHBOARD_ORIGIN=https://gogymgo-admin-control.wilson-1212.chatgpt.site

# The historical D1 export route stays unavailable unless both values are
# configured in the owner-restricted Sites environment for an approved export.
LANDING_D1_EXPORT_ENABLED=no
LANDING_D1_EXPORT_OWNER_EMAIL=
