NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:19000
TRUST_PROXY=false
OPENAPI_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
WORKER_POLL_INTERVAL_MS=5000

# Firebase ID tokens are verified server-side. Use Application Default Credentials;
# never commit a service-account JSON file.
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_EMULATOR_HOST=

DATABASE_URL=postgresql://gogymgo:gogymgo@localhost:5432/gogymgo
DATABASE_POOL_MAX=10
GCP_STORAGE_BUCKET=

PUSH_NOTIFICATIONS_ENABLED=false
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_ACCESS_TOKEN=

# Populate these through the deployment secret manager, never through Expo variables.
HYPERWALLET_ENABLED=false
HYPERWALLET_API_URL=https://uat-api.paylution.com/rest/v4
HYPERWALLET_PORTAL_URL=
HYPERWALLET_PROGRAM_TOKEN=
HYPERWALLET_USERNAME=
HYPERWALLET_PASSWORD=
HYPERWALLET_WEBHOOK_USERNAME=
HYPERWALLET_WEBHOOK_PASSWORD=
