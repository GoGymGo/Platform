# Backend origin only. Versioned /v1 paths are added by the app repositories.
EXPO_PUBLIC_API_URL=

# Firebase web-app configuration. These identify the Firebase project but are not server secrets.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Web OAuth client ID used to exchange native Google credentials with Firebase.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_ENABLE_GOOGLE_AUTH=false
EXPO_PUBLIC_ENABLE_APPLE_AUTH=false

# Enables the standalone sample-data browser test build. Never enable for store builds.
EXPO_PUBLIC_ENABLE_BROWSER_TEST_PREVIEW=false

# Final store identifiers. They must match the iOS and Android apps registered in Firebase.
GOGYMGO_IOS_BUNDLE_ID=
GOGYMGO_ANDROID_PACKAGE=

# Required to make https://app.gogymgo.com/scan open the installed native app.
# The Android value accepts comma-separated SHA-256 fingerprints when both upload
# and Play App Signing certificates must be trusted.
GOGYMGO_IOS_TEAM_ID=
GOGYMGO_ANDROID_CERT_SHA256=

# Public store-review URLs. Account deletion must be available both in-app and on the web.
GOGYMGO_PRIVACY_POLICY_URL=
GOGYMGO_ACCOUNT_DELETION_URL=
