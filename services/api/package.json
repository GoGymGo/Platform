{
  "name": "@gogymgo/api",
  "version": "0.1.0",
  "description": "Authoritative GoGymGo API and background-worker modular monolith",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && tsc --project tsconfig.migrations.json",
    "format": "prettier --write \"{src,test,scripts,migrations}/**/*.{ts,mjs}\" \"*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"{src,test,scripts,migrations}/**/*.{ts,mjs}\" \"*.{json,md,yml,yaml}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --require ./dist/observability/instrumentation.js dist/main",
    "start:worker": "node --require ./dist/observability/instrumentation.js dist/worker",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,test,scripts,migrations}/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"{src,test,scripts,migrations}/**/*.ts\" --fix",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "test:journeys": "jest --config ./test/jest-integration.json --runInBand --runTestsByPath test/critical-session-workflow.integration-spec.ts test/gym-qr-workflow.integration-spec.ts test/region-verification.integration-spec.ts test/social-challenge-workflow.integration-spec.ts",
    "test:smoke:qr": "jest --config ./test/jest-integration.json --runInBand --runTestsByPath test/gym-qr-workflow.integration-spec.ts",
    "migrate:create": "node-pg-migrate create --migration-file-language ts",
    "migrate:up": "node-pg-migrate up --tsx --envPath .env --migrations-dir migrations",
    "migrate:down": "node-pg-migrate down --tsx --envPath .env --migrations-dir migrations",
    "migrate:deploy": "node-pg-migrate up --migrations-dir dist/migrations --database-url-var DATABASE_URL",
    "openapi:generate": "ts-node --project tsconfig.json scripts/generate-openapi.ts",
    "secret:reward-code:local": "node scripts/configure-local-reward-key.mjs",
    "audit:source": "node scripts/audit-source.mjs",
    "audit:production-build": "node scripts/audit-production-build.mjs",
    "audit:contract": "node scripts/audit-frontend-contract.mjs",
    "audit:deps": "npm audit --omit=dev --omit=optional --audit-level=moderate",
    "admin:bootstrap": "ts-node --project tsconfig.json scripts/bootstrap-admin.ts",
    "partner:access": "ts-node --project tsconfig.json scripts/configure-gym-partner-access.ts",
    "pilot:reset-onboarding": "ts-node --project tsconfig.json scripts/reset-pilot-onboarding.ts",
    "pilot:import-landing-d1": "ts-node --project tsconfig.json scripts/import-landing-d1.ts",
    "configure:september-2026-island-pilot": "ts-node --project tsconfig.json src/operations/configure-september-2026-island-pilot.ts",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test:cov && npm run test:e2e && npm run test:integration && npm run openapi:generate && npm run format:check && npm run audit:contract && npm run audit:source && npm run build && npm run audit:production-build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1101.0",
    "@aws-sdk/credential-provider-node": "3.972.76",
    "@aws-sdk/s3-request-presigner": "3.1101.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.220.0",
    "@opentelemetry/instrumentation-express": "0.68.0",
    "@opentelemetry/instrumentation-http": "0.220.0",
    "@opentelemetry/instrumentation-pg": "0.72.0",
    "@opentelemetry/sdk-metrics": "2.9.0",
    "@opentelemetry/sdk-node": "0.220.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "firebase-admin": "^14.1.0",
    "google-auth-library": "10.9.0",
    "helmet": "^8.3.0",
    "kysely": "0.28.17",
    "nestjs-pino": "^4.6.1",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.0.4",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.module.ts",
      "!main.ts"
    ],
    "coverageReporters": [
      "text-summary",
      "html",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 19,
        "functions": 19,
        "lines": 28,
        "statements": 28
      }
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
