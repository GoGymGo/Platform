NODE_ENV=development
RUNTIME_ROLE=api
PORT=3000
LOG_LEVEL=debug
PRETTY_LOGS_ENABLED=true
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:19000
TRUST_PROXY=false
OPENAPI_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
WORKER_POLL_INTERVAL_MS=5000
WORKER_HEARTBEAT_INTERVAL_MS=30000
WORKER_STALE_AFTER_MS=120000

# OTLP traces and metrics are disabled unless a collector endpoint is configured.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

# Firebase ID tokens are verified server-side. Use Application Default Credentials;
# never commit a service-account JSON file.
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_EMULATOR_HOST=

# Local British Columbia, Canada demo adapter. It records only a short-lived checkpoint,
# never biometric, camera, health, eligibility, prize, or payout data.
# Environment validation prevents this adapter from running in production.
DEMO_VERIFICATION_ENABLED=false
DEMO_VERIFICATION_REGION_CODE=CA-BC
DEMO_VERIFICATION_TTL_SECONDS=300

DATABASE_URL=postgresql://gogymgo:gogymgo@localhost:5432/gogymgo
DATABASE_POOL_MAX=10
GCP_STORAGE_BUCKET=

# Avatar uploads remain private and pending moderation until operator approval.
PROFILE_MEDIA_ENABLED=false
PROFILE_MEDIA_MAX_BYTES=2097152
PROFILE_MEDIA_UPLOAD_TTL_SECONDS=300
PROFILE_MEDIA_READ_TTL_SECONDS=300

# Privacy exports use a separate private bucket with a seven-day lifecycle rule.
# The pseudonymization key must be a random secret of at least 32 characters.
PRIVACY_OPERATIONS_ENABLED=false
PRIVACY_EXPORT_BUCKET=
PRIVACY_EXPORT_RETENTION_DAYS=7
PRIVACY_DOWNLOAD_URL_TTL_SECONDS=300
PRIVACY_JOB_LEASE_SECONDS=600
PRIVACY_PSEUDONYMIZATION_KEY=

PUSH_NOTIFICATIONS_ENABLED=false
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_ACCESS_TOKEN=

# Populate these through the deployment secret manager, never through Expo variables.
HYPERWALLET_ENABLED=false
HYPERWALLET_API_URL=https://uat-api.paylution.com/rest/v4
HYPERWALLET_PORTAL_URL=
HYPERWALLET_PROGRAM_TOKEN=
HYPERWALLET_USERNAME=
HYPERWALLET_PASSWORD=
HYPERWALLET_WEBHOOK_USERNAME=
HYPERWALLET_WEBHOOK_PASSWORD=
