# Server-only backend origin. The proxy only forwards /v1/operator/* requests.
GOGYMGO_API_URL=

# Public Firebase web-app configuration for the existing GoGymGo project.
# These identify the Firebase project; Firebase Admin credentials never belong here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Canonical admin origin used for metadata when request headers are unavailable.
SITE_URL=https://admin.gogymgo.com
