NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:19000
TRUST_PROXY=false
OPENAPI_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# Firebase ID tokens are verified server-side. Use Application Default Credentials;
# never commit a service-account JSON file.
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_EMULATOR_HOST=

DATABASE_URL=postgresql://gogymgo:gogymgo@localhost:5432/gogymgo
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
GCP_STORAGE_BUCKET=

# Populate these through the deployment secret manager, never through Expo variables.
HYPERWALLET_API_URL=https://api.sandbox.hyperwallet.com
HYPERWALLET_PROGRAM_TOKEN=
HYPERWALLET_USERNAME=
HYPERWALLET_PASSWORD=
HYPERWALLET_WEBHOOK_SECRET=
