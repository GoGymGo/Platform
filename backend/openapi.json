  "info": {
    "title": "GoGymGo API",
    "description": "Authoritative API for GoGymGo accounts, verified competition activity, ledgers, results, and payouts.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "firebase": {
        "scheme": "bearer",
        "bearerFormat": "Firebase ID token",
        "type": "http",
        "description": "Firebase ID token verified by the GoGymGo API."
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "example": "gogymgo-api"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-07-12T12:00:00.000Z"
          },
          "uptimeSeconds": {
            "type": "number",
            "example": 123.45
          }
        },
        "required": [
          "service",
          "status",
          "timestamp",
          "uptimeSeconds"
        ]
      },
      "PrivacySettingsDto": {
        "type": "object",
        "properties": {
          "showRegion": {
            "type": "boolean"
          },
          "showStats": {
            "type": "boolean"
          }
        },
        "required": [
          "showRegion",
          "showStats"
        ]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "callsign": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "emailVerified": {
            "type": "boolean"
          },
          "publicIdentityMode": {
            "type": "string",
            "enum": [
              "private",
              "alias",
              "real_name"
            ]
          },
          "publicName": {
            "type": "string",
            "nullable": true
          },
          "privacySettings": {
            "$ref": "#/components/schemas/PrivacySettingsDto"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended",
              "deleted"
            ]
          },
          "version": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "callsign",
          "email",
          "emailVerified",
          "publicIdentityMode",
          "publicName",
          "privacySettings",
          "roles",
          "status",
          "version"
        ]
      },
      "UpdatePrivacySettingsDto": {
        "type": "object",
        "properties": {
          "showRegion": {
            "type": "boolean"
          },
          "showStats": {
            "type": "boolean"
          }
        }
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "publicIdentityMode": {
            "type": "string",
            "enum": [
              "private",
              "alias",
              "real_name"
            ]
          },
          "publicName": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "nullable": true
          },
          "privacySettings": {
            "$ref": "#/components/schemas/UpdatePrivacySettingsDto"
          }
        }
      },
      "RegionPolicyResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "example": "CA-BC-VICTORIA"
          },
          "countryCode": {
            "type": "string",
            "example": "CA"
          },
          "subdivisionCode": {
            "type": "string",
            "example": "BC"
          },
          "metroName": {
            "type": "string",
            "example": "Victoria"
          },
          "currency": {
            "type": "string",
            "example": "CAD"
          },
          "timezone": {
            "type": "string",
            "example": "America/Vancouver"
          },
          "languageCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "minimumAge": {
            "type": "number",
            "example": 19
          },
          "competitionEnabled": {
            "type": "boolean"
          },
          "payoutEnabled": {
            "type": "boolean"
          },
          "policyVersion": {
            "type": "string"
          },
          "boundaryVersion": {
            "type": "string"
          },
          "validFrom": {
            "type": "string",
            "format": "date-time"
          },
          "validTo": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "code",
          "countryCode",
          "subdivisionCode",
          "metroName",
          "currency",
          "timezone",
          "languageCodes",
          "minimumAge",
          "competitionEnabled",
          "payoutEnabled",
          "policyVersion",
          "boundaryVersion",
          "validFrom",
          "validTo"
        ]
      },
      "CreateRegionVerificationDto": {
        "type": "object",
        "properties": {
          "regionPolicyId": {
            "type": "string",
            "format": "uuid"
          },
          "method": {
            "type": "string",
            "enum": [
              "device_location",
              "postal_code"
            ]
          },
          "latitude": {
            "type": "number",
            "maximum": 90,
            "minimum": -90
          },
          "longitude": {
            "type": "number",
            "maximum": 180,
            "minimum": -180
          },
          "postalCode": {
            "type": "string"
          }
        },
        "required": [
          "regionPolicyId",
          "method"
        ]
      },
      "RegionVerificationResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "regionPolicyId": {
            "type": "string",
            "format": "uuid"
          },
          "method": {
            "type": "string",
            "enum": [
              "device_location",
              "postal_code",
              "manual_review"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected",
              "expired"
            ]
          },
          "policyVersion": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "regionPolicyId",
          "method",
          "status",
          "policyVersion",
          "createdAt"
        ]
      },
      "CompetitionRulesResponseDto": {
        "type": "object",
        "properties": {
          "minSessionMinutes": {
            "type": "number"
          },
          "minHeartRateSamples": {
            "type": "number"
          },
          "requireFaceCheck": {
            "type": "boolean"
          },
          "requireGymQr": {
            "type": "boolean"
          },
          "signupPrizeDrawEntries": {
            "type": "number"
          },
          "verifiedSessionCategoryScore": {
            "type": "number"
          },
          "verifiedSessionPrizeDrawEntries": {
            "type": "number"
          },
          "payoutPoolAmountMinor": {
            "type": "number"
          },
          "payoutWinnerCount": {
            "type": "number"
          },
          "payoutExponent": {
            "type": "number"
          }
        },
        "required": [
          "minSessionMinutes",
          "minHeartRateSamples",
          "requireFaceCheck",
          "requireGymQr",
          "signupPrizeDrawEntries",
          "verifiedSessionCategoryScore",
          "verifiedSessionPrizeDrawEntries",
          "payoutPoolAmountMinor",
          "payoutWinnerCount",
          "payoutExponent"
        ]
      },
      "CompetitionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "monthKey": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "registration",
              "active",
              "settling",
              "settled",
              "cancelled"
            ]
          },
          "currency": {
            "type": "string"
          },
          "regionCode": {
            "type": "string"
          },
          "regionName": {
            "type": "string"
          },
          "rulesVersion": {
            "type": "string"
          },
          "rules": {
            "$ref": "#/components/schemas/CompetitionRulesResponseDto"
          },
          "goalDays": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "registrationOpensAt": {
            "type": "string",
            "format": "date-time"
          },
          "registrationClosesAt": {
            "type": "string",
            "format": "date-time"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "monthKey",
          "name",
          "status",
          "currency",
          "regionCode",
          "regionName",
          "rulesVersion",
          "rules",
          "goalDays",
          "registrationOpensAt",
          "registrationClosesAt",
          "startsAt",
          "endsAt"
        ]
      },
      "CreateEnrollmentDto": {
        "type": "object",
        "properties": {
          "goalDays": {
            "type": "number",
            "maximum": 7,
            "minimum": 1
          },
          "regionVerificationId": {
            "type": "string",
            "format": "uuid"
          },
          "rulesAccepted": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "ageEligibilityAttested": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "goalDays",
          "regionVerificationId",
          "rulesAccepted",
          "ageEligibilityAttested"
        ]
      },
      "EnrollmentResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "competitionId": {
            "type": "string",
            "format": "uuid"
          },
          "goalDays": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "withdrawn",
              "disqualified"
            ]
          },
          "enrolledAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "competitionId",
          "goalDays",
          "status",
          "enrolledAt"
        ]
      },
      "EnrollmentCountResponseDto": {
        "type": "object",
        "properties": {
          "count": {
            "type": "number"
          }
        },
        "required": [
          "count"
        ]
      },
      "CompetitionMatchResponseDto": {
        "type": "object",
        "properties": {
          "availability": {
            "type": "string",
            "enum": [
              "matched",
              "searching",
              "solo"
            ]
          },
          "opponentAlias": {
            "type": "string"
          },
          "opponentVerifiedDateKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "periodIndex": {
            "type": "number",
            "maximum": 4,
            "minimum": 1
          },
          "region": {
            "type": "string"
          }
        },
        "required": [
          "availability",
          "opponentAlias",
          "opponentVerifiedDateKeys",
          "periodIndex",
          "region"
        ]
      },
      "CreateSessionDto": {
        "type": "object",
        "properties": {
          "competitionId": {
            "type": "string",
            "format": "uuid"
          },
          "clientStartedAt": {
            "type": "string",
            "format": "date-time"
