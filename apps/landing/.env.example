GOGYMGO_API_URL=
# Server-only value shared with the API. Public intake stays unavailable unless
# the exact value is present in both runtimes; never expose it as NEXT_PUBLIC_*.
GOGYMGO_LANDING_FORWARDING_SECRET=

# Canonical member-app origin. Only the approved HTTPS production origin, or a
# loopback origin in local development, is accepted. Missing or rejected values
# render member-app controls unavailable rather than guessing a destination.
NEXT_PUBLIC_MEMBER_APP_ORIGIN=https://app.gogymgo.com

# Set to yes only in the exact landing release built after the September
# Contest, legal documents and sole $100 CAD manual-handoff reward are all
# approved and published. Every other value keeps registration claims closed.
NEXT_PUBLIC_SEPTEMBER_PILOT_PUBLISHED=no

# The historical D1 export route stays unavailable unless both values are
# configured in the owner-restricted Sites environment for an approved export.
# Public-site feedback/event export additionally requires the exact platform
# owner user ID and both approved retention values below.
LANDING_D1_EXPORT_ENABLED=no
LANDING_D1_EXPORT_OWNER_EMAIL=
LANDING_D1_EXPORT_OWNER_USER_ID=
# One approved export uses one UUID and one frozen exclusive UTC cutoff across
# every page. Missing or malformed values keep the route hidden.
LANDING_D1_EXPORT_ID=
LANDING_D1_EXPORT_CUTOFF_EXCLUSIVE=

# Public-site retention deletion is a separate destructive operation and stays
# unavailable unless explicitly approved. It uses the same exact owner pair.
LANDING_D1_RETENTION_ENABLED=no

# Required before public feedback or anonymous event writes are available.
# Feedback accepts 30-180 days; anonymous events accept 7-90 days. Blank,
# malformed, or out-of-range values fail closed and keep writes/exports off.
PUBLIC_SITE_FEEDBACK_RETENTION_DAYS=
PUBLIC_SITE_EVENT_RETENTION_DAYS=
